# copy to back/.env (all optional). VS_ prefix: a Claude Code terminal exports CLAUDE_* variables of its own
# claude CLI binary and model used to make the videos
VS_CLAUDE_BIN=claude
VS_CLAUDE_MODEL=claude-opus-5-5
# default reasoning effort: low | medium | high | xhigh | max
VS_CLAUDE_EFFORT=high
# models offered in the app selector (default list: Opus 5.5, Fable 5.1, Sonnet 5.5, Haiku 4.5)
# VS_CLAUDE_MODELS=claude-opus-5-5:Opus 5.5,claude-sonnet-5-5:Sonnet 5.5
# bypassPermissions: claude runs every command without asking (no human in the loop). Other values: acceptEdits, default
VS_CLAUDE_PERMISSION_MODE=bypassPermissions
# workspace with engine/, projects/ and CLAUDE.md (default: the parent folder of back/)
# WORKSPACE_DIR=/path/to/video
RUN_PROD_MODE=True
RUN_DEV_MODE=False
